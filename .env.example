# ============================================================================
# AI Career Intelligence Platform - Production Configuration
# ============================================================================

# Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Application Ports
API_PORT=8000
STREAMLIT_PORT=8501
DB_PATH=data/meeting_intelligence.db

# LLM Configuration (Google Gemini / Groq / OpenAI)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_gemini_api_key_here
LLM_MAX_TOKENS=4000
LLM_CHUNK_SIZE=3000
LLM_FALLBACK_MODEL=gemini-1.5-flash
LLM_MAX_RETRIES=4
LLM_INITIAL_RETRY_DELAY=2
LLM_MAX_RETRY_DELAY=30

# Security & Multi-Tenant Authentication (Milestone 4 - Task 7)
AUTH_SECRET_KEY=your-production-hmac-sha256-signing-secret-key-2026
API_SECRET_KEY=your-production-fastapi-x-api-key-2026

# Zoom Cloud Platform Integration (Milestone 4 - Task 4)
# Leave empty to use built-in sandbox mock recordings
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret
ZOOM_WEBHOOK_SECRET_TOKEN=your_zoom_webhook_secret_token

# Google Meet & Drive Integration (Milestone 4 - Task 5)
# Leave empty to use built-in sandbox mock recordings
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_DRIVE_FOLDER_ID=meet_recordings_folder_id
GOOGLE_SERVICE_ACCOUNT_JSON=config/google_service_account.json